import{useState, useEffect} from 'react';

import './App.css';
const API_URL = 'http://localhost:5000/api/clothes';
const SWAP_URL = 'http://localhost:5000/api/swaps';
function App() {
  const [clothes, setClothes] = useState([]);
const [loading, setLoading] = useState(true);
const [error, setError] = useState('');
const [swaps, setSwaps] = useState([]);
const [notice, setNotice] = useState('');


useEffect(() => {
  async function loadClothes() {
    try {
      const res = await fetch(API_URL);
      if (!res.ok) throw new Error('Server error');
      const data = await res.json();
      setClothes(data);
    } catch (err) {
      setError('Could not load clothes. Is the backend running?');
    } finally {
      setLoading(false);
    }
  }
  loadClothes();
}, []);
    
  const [item, setItem] = useState('');
  const [filter, setFilter] = useState('All');
  const [category, setCategory] = useState('Men');
  const [image, setImage] = useState('');

  async function addClothes(e) {
  e.preventDefault();

  if (!item.trim()) {
    setError('Please enter a clothing name.');
    return;
  }

  try {
    setError('');
    const res = await fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        item: item.trim(),
        category,
        image,
      }),
    });
    if (!res.ok) throw new Error('Failed to save');
    const saved = await res.json();
    setClothes([saved, ...clothes]);
    setItem('');
    setImage('');
  } catch (err) {
    setError('Could not save the item. Please try again.');
  }
}

  // Filter clothes by category
  const filteredClothes =
    filter === 'All'
      ? clothes
      : clothes.filter((cloth) => cloth.category === filter);

  // Remove clothing
  async function removeClothes(id) {
  try {
    setError('');
    const res = await fetch(API_URL + '/' + id, { method: 'DELETE' });
    if (!res.ok) throw new Error('Failed to delete');
    setClothes(clothes.filter((cloth) => cloth._id !== id));
  } catch (err) {
    setError('Could not delete the item. Please try again.');
  }
  setError('Could not delete the item. Please try again.');
  }
}
  async function loadSwaps() {
  async function loadSwaps() {
  try {
    const res = await fetch(SWAP_URL);
    if (res.ok) setSwaps(await res.json());
  } catch (err) {
    console.error(err);
  }
}

useEffect(() => {
  loadSwaps();
}, []);

async function requestSwap(itemId) {
  const name = window.prompt('Enter your name:');
  if (!name || !name.trim()) return;
  const message = window.prompt('Message for the owner (optional):') || '';

  try {
    setError('');
    const res = await fetch(SWAP_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        requestedItem: itemId,
        requesterName: name.trim(),
        message: message,
      }),
    });
    if (!res.ok) throw new Error('Failed');
    setNotice('Swap request sent!');
    loadSwaps();
  } catch (err) {
    setError('Could not send swap request.');
  }
}

async function updateSwap(id, status) {
  try {
    const res = await fetch(SWAP_URL + '/' + id, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: status }),
    });
    if (!res.ok) throw new Error('Failed');
    loadSwaps();
  } catch (err) {
    setError('Could not update request.');
  }
}


  return (
    <div className="app">
      <header>
        <h1>ClothingSwap 👕</h1>
        <p>Swap clothes. Refresh your style.</p>
      </header>

      <main>
        <section className="hero">
          <h2>Give Clothes a Second Life</h2>
          <p>
            List your pre-loved clothes and discover something new.
          </p>
        </section>

        {/* Form to add clothing */}
        <section className="listing">
          <h2>List Your Clothes</h2>

          <form onSubmit={addClothes}>
            <input
  type="file"
  accept="image/*"
  onChange={(e) => {
    const file = e.target.files[0];

    if (file) {
      const reader = new FileReader();

      reader.onloadend = () => {
        setImage(reader.result);
      };

      reader.readAsDataURL(file);
    }
  }}
/>
            <input
              value={item}
              onChange={(e) => setItem(e.target.value)}
              placeholder="Enter clothing name"
              required
            />

            <select
              value={category}
              onChange={(e) => setCategory(e.target.value)}
            >
              <option value="Men">Men</option>
              <option value="Women">Women</option>
              <option value="Kids">Kids</option>
              <option value="Accessories">Accessories</option>
            </select>

            <button type="submit">Add Clothing</button>
          </form>
        </section>

        {/* Available clothes and category filters */}
        <section className="items">
          <h2>Available Clothes ({filteredClothes.length})</h2>
          {loading && <p>Loading clothes...</p>}
{error && <p style={{ color: 'red' }}>{error}</p>}

          <div className="filters">
            {['All', 'Men', 'Women', 'Kids', 'Accessories'].map(
              (categoryName) => (
                <button
                  type="button"
                  key={categoryName}
                  onClick={() => setFilter(categoryName)}
                  className={filter === categoryName ? 'active' : ''}
                >
                  {categoryName}
                </button>
              )
            )}
          </div>

          <div className="grid">
            {filteredClothes.length === 0 ? (
              <p>No clothes found. Add some clothes to get started!</p>
            ) : (
              filteredClothes.map((cloth) => (
                <article className="card" key={cloth._id || cloth.id}>
  {cloth.image && (
    <img
      src={cloth.image}
      alt={cloth.item}
      className="clothing-image"
    />
  )}
  <h3>{cloth.item}</h3>
  <p>Category: {cloth.category}</p>

  <button type="button" onClick={() => requestSwap(cloth._id)}>
    Request Swap
  </button>
  <button type="button" onClick={() => removeClothes(cloth._id)}>
    Remove
  </button>
</article>
              ))
            )}
          </div>
        </section>
      <section className="items">
  <h2>Swap Requests ({swaps.length})</h2>
  {notice && <p style={{ color: 'green' }}>{notice}</p>}
  {swaps.length === 0 ? (
    <p>No swap requests yet.</p>
  ) : (
    swaps.map((swap) => (
      <article className="card" key={swap._id}>
        <h3>{swap.requestedItem ? swap.requestedItem.item : 'Item removed'}</h3>
        <p>Requested by: {swap.requesterName}</p>
        {swap.message && <p>Message: {swap.message}</p>}
        <p>Status: <strong>{swap.status}</strong></p>
        {swap.status === 'pending' && (
          <div>
            <button type="button" onClick={() => updateSwap(swap._id, 'accepted')}>
              Accept
            </button>
            <button type="button" onClick={() => updateSwap(swap._id, 'rejected')}>
              Reject
            </button>
          </div>
        )}
      </article>
    ))
  )}
</section>
      </main>
    </div>
  );
}

export default App;